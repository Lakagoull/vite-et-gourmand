# Copier ce fichier en .env puis adapter les valeurs
APP_ENV=dev
APP_URL=http://localhost:8000

# Base relationnelle (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vite_gourmand
DB_USER=root
DB_PASSWORD=

# Base NoSQL (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=vite_gourmand

# Envoi des mails (si SMTP_HOST est vide, les mails sont enregistrés dans storage/mails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@vite-gourmand.fr
MAIL_FROM_NAME="Vite & Gourmand"
MAIL_ENTREPRISE=contact@vite-gourmand.fr
